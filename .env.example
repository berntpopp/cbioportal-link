# cbioportal-link configuration
#
# Copy to .env and edit. All variables use the CBIOPORTAL_LINK_ prefix.
# Nested settings use a double-underscore delimiter (e.g. CBIOPORTAL_LINK_CBIO__BASE_URL).

# --- Server ---
CBIOPORTAL_LINK_HOST=127.0.0.1
CBIOPORTAL_LINK_ALLOW_PUBLIC_BIND=false
CBIOPORTAL_LINK_PORT=8000
# transport: unified | http | stdio
CBIOPORTAL_LINK_TRANSPORT=unified
CBIOPORTAL_LINK_MCP_PATH=/mcp
CBIOPORTAL_LINK_ALLOWED_HOSTS='["localhost","127.0.0.1","::1"]'
CBIOPORTAL_LINK_ALLOWED_ORIGINS='[]'
# Comma-separated list of allowed CORS origins (empty = none)
CBIOPORTAL_LINK_CORS_ORIGINS=
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CBIOPORTAL_LINK_LOG_LEVEL=INFO
# log_format: json | console
CBIOPORTAL_LINK_LOG_FORMAT=console

# --- cBioPortal upstream (nested: cbio) ---
CBIOPORTAL_LINK_CBIO__BASE_URL=https://api.cbioportal.org
CBIOPORTAL_LINK_CBIO__REQUEST_TIMEOUT_S=20.0
# Politeness (cBioPortal llms.txt): requests run one at a time; 0.5 s spacing on top.
CBIOPORTAL_LINK_CBIO__MIN_INTERVAL_S=0.5
CBIOPORTAL_LINK_CBIO__DAILY_CAP=20000
CBIOPORTAL_LINK_CBIO__MAX_WAIT_S=30.0
CBIOPORTAL_LINK_CBIO__MAX_RETRIES=2
CBIOPORTAL_LINK_CBIO__BACKOFF_BASE_S=2.0
CBIOPORTAL_LINK_CBIO__MAX_RESPONSE_BYTES=16777216
# In-process response cache (no on-disk state); keys include /api/info dbVersion
CBIOPORTAL_LINK_CBIO__CACHE_TTL_S=86400
CBIOPORTAL_LINK_CBIO__INFO_TTL_S=3600
CBIOPORTAL_LINK_CBIO__CACHE_MAXSIZE=512
